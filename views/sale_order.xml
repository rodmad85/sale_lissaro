<xpath expr="//kanban" position="replace">
              <kanban class="o_kanban_mobile" sample="1" quick_create="false">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="amount_total"/>
                    <field name="order_line"/>
                    <field name="date_order"/>
                    <field name="state"/>
                    <field name="currency_id"/>
                    <field name="activity_state"/>
                    <progressbar field="activity_state" colors="{&quot;planned&quot;: &quot;success&quot;, &quot;today&quot;: &quot;warning&quot;, &quot;overdue&quot;: &quot;danger&quot;}"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                                <div class="o_kanban_record_top mb16">
                                    <div class="o_kanban_record_headings mt4">
                                        <strong class="o_kanban_record_title"><!--<t t-esc="record.name.value"/> --> <span><t t-esc="record.partner_id.value"/></span> - <span><t t-esc="record.name.value"/></span></strong>
                                    </div>

                                </div>
                           <div class="o_kanban_details">
                             <field name="product_kanban" widget="many2many_tags"/>

                          </div>

                                <div class="o_kanban_record_bottom">



                                    <div class="oe_kanban_bottom_left text-muted">
                                        <span><t t-esc="record.date_order.value"/></span>
                                        <field name="activity_ids" widget="kanban_activity"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="state" widget="label_selection" options="{'classes': {'draft': 'default', 'cancel': 'default', 'done': 'success'}}"/>
                                         <field name="delivery_status" optional="show" widget="badge" decoration-muted="delivery_status == 'nothing'" decoration-warning="delivery_status == 'to_deliver' or delivery_status == 'processing'" decoration-info="delivery_status == 'partial'" decoration-success="delivery_status == 'delivered'"/>
                                    </div>

                                </div>
                                <strong><field name="amount_total" widget="monetary"/></strong>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </xpath>
